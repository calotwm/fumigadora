# Reference of the environment variables the server reads. The server does NOT load .env files:
# set these in the shell (local) or in the host's variables (Railway). Never commit real secrets.

# Postgres connection string. Leave unset locally to use the embedded PGlite database
# (stored in server/.data/pglite). On Railway, reference the Postgres plugin:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Single admin password for the login screen. REQUIRED in production.
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC). REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Directory for stored files (certificate PDFs). Defaults to server/.data/files.
# On Railway: create a volume in the service settings (UI), mount it at /data and set FILES_DIR=/data/files
FILES_DIR=

# HTTP port. Railway injects this automatically; defaults to 3000.
PORT=3000

# Email (optional; without both RESEND_API_KEY and MAIL_FROM emails are only simulated)
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# ARCA electronic invoicing (all optional; inactive until all are set, see docs/arca.md)
# ARCA_ENV=homologacion
# ARCA_CUIT=20-12345678-6
# ARCA_CERT=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
# ARCA_KEY=base64-or-escaped-PEM-private-key
# ARCA_PTO_VTA=3
# ARCA_TAX_CONDITION=monotributo
