# Copy to .env for local overrides. Never commit real secrets.

# Postgres connection string. Leave unset locally to use the embedded PGlite database
# (stored in server/.data/pglite). On Railway, reference the Postgres plugin:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Single admin password for the login screen. REQUIRED in production.
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie (HMAC). REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# HTTP port. Railway injects this automatically; defaults to 3000.
PORT=3000

# Email (optional; without both RESEND_API_KEY and MAIL_FROM emails are only simulated)
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
