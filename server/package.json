{
  "name": "@fumigadora/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/seed.ts",
    "push:keys": "tsx src/vapid-keys.ts",
    "db:import-legacy": "tsx src/import-legacy.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@fumigadora/shared": "*",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.0",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.9.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
